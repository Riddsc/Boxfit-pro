<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sfw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/sf_widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/sfw_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Satronho BoxFit" android:textSize="12sp" android:textStyle="bold" android:maxLines="1"/>
        <TextView android:id="@+id/sfw_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥 0" android:textSize="18sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/sfw_kcal_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
        <TextView android:id="@+id/sfw_kcal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1"/>
        <ProgressBar android:id="@+id/sfw_kcal_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/sf_bar_kcal"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/sfw_min_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp">
        <TextView android:id="@+id/sfw_min" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1"/>
        <ProgressBar android:id="@+id/sfw_min_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/sf_bar_min"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/sfw_steps_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp">
        <TextView android:id="@+id/sfw_steps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1"/>
        <ProgressBar android:id="@+id/sfw_steps_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/sf_bar_steps"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/sfw_water_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp">
        <TextView android:id="@+id/sfw_water" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1"/>
        <ProgressBar android:id="@+id/sfw_water_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/sf_bar_water"/>
    </LinearLayout>
</LinearLayout>
